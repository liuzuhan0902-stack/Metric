# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the Python version
#   is generally handled by the user. In this case, however, you're building an application,
#   so you'll want to keep track of the Python version.
# .python-version

# pipenv
#   According to pypa/pipenv#1191, it is recommended to not check in Pipfile.lock into version control.
#   However, in case of collaboration, if you want to keep the same environment for everyone, you should check in Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock contains the exact versions of dependencies used in the project.
#   If you are building a library, you should not check in poetry.lock.
#   If you are building an application, you should check in poetry.lock.
# poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm.lock contains the exact versions of dependencies used in the project.
# .pdm-python
# .pdm-build/

# PEP 582; used by e.g. github.com/pdm-project/pdm
__pypackages__/

